page { background: #efecdf; font-family: ui-monospace, Menlo, monospace; color: #26241c; }
.card { background: #faf8ee; border: 3px solid #26241c; margin: 16px; padding: 20px; }
.title { font-size: 18px; font-weight: 700; margin-bottom: 12px; }
.step { font-size: 13px; color: #7c7867; margin: 6px 0; }
.big { font-size: 48px; font-weight: 700; margin: 8px 0; }
.muted { color: #7c7867; font-size: 12px; }
.mono { font-family: ui-monospace, Menlo, monospace; }
.code-input { border: 3px solid #26241c; padding: 14px; margin: 12px 0; font-size: 20px; font-weight: 700; letter-spacing: 8px; text-align: center; }
button { background: #26241c; color: #efecdf; border-radius: 0; font-weight: 700; }
button[disabled] { background: #c8c3ad; color: #efecdf; }
.tip { border-color: #a3463c; }
.btn-text { background: none; color: #7c7867; font-weight: 400; font-size: 12px; padding: 0; margin: 0; }
